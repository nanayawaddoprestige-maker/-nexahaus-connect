// NexaHaus Connect — Prisma schema
// Source of truth: docs/DATABASE.md. Enum values mirror packages/types/src/enums.ts
// (a schema test asserts they stay in sync).
//
// Conventions:
//  - Primary keys: UUID v7 (`@default(uuid(7))`) — sortable, non-enumerable.
//  - Money: integer minor units in `BigInt` + a sibling `*Currency` Char(3). Never Float.
//  - Rates/percentages: Decimal.
//  - `createdAt` / `updatedAt` on every table; business time is separate.
//  - Soft delete: `deletedAt` where deletion is permitted. Financial/audit rows are never
//    hard-deleted casually.
//  - Actor-trail fields (`createdById`, `approvedById`, ...) are plain String user. ids
//    (no Prisma relation) to keep the User model small; FK hardening is a follow-up
//    migration. Semantically primary user links ARE real relations (see model User).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Identity & Access
// ===========================================================================

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  id              String     @id @default(uuid(7))
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String
  fullName        String
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  avatarDocumentId String?
  mfaEnabled      Boolean    @default(false)
  mfaSecretEnc    String?
  lastLoginAt     DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  roles                 UserRole[]
  sessions              Session[]
  otpChallenges         OtpChallenge[]
  passwordResetTokens   PasswordResetToken[]
  clientLinks           ClientUser[]
  propertyAssignments   PropertyAssignment[]
  threadParticipations  ThreadParticipant[]
  messagesSent          Message[]
  notifications         Notification[]
  notificationPrefs     NotificationPreference[]
  leadActivities        LeadActivity[]
  inspectionsAssigned   Inspection[]           @relation("InspectionInspector")
  tasksAssigned         Task[]                 @relation("TaskAssignee")
  accountManagedClients Client[]               @relation("ClientAccountManager")
  ownedLeads            Lead[]                 @relation("LeadOwner")
  tenantProfile         Tenant?                @relation("TenantLoginUser")
  vendorProfile         Vendor?                @relation("VendorLoginUser")

  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7))
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7))
  key         String   @unique
  description String?
  group       String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id          String   @id @default(uuid(7))
  userId      String
  roleId      String
  grantedById String?
  grantedAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid(7))
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  deviceLabel      String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  rotatedFromId    String?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

enum OtpPurpose {
  VERIFY_EMAIL
  VERIFY_PHONE
  LOGIN_MFA
  PASSWORD_RESET
}

model OtpChallenge {
  id          String     @id @default(uuid(7))
  userId      String?
  destination String
  purpose     OtpPurpose
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int        @default(0)
  createdAt   DateTime   @default(now())
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([destination, purpose])
  @@map("otp_challenges")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7))
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ===========================================================================
// Client (Owner) & CRM
// ===========================================================================

enum ClientType {
  INDIVIDUAL
  COMPANY
}

enum ClientSegment {
  DIASPORA
  RESIDENT
  INVESTOR
  DEVELOPER
  COMMERCIAL
  OTHER
}

enum ClientStatus {
  PROSPECT
  ONBOARDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ServicePackage {
  BASIC
  PROFESSIONAL
  PREMIUM
  ENTERPRISE
}

model Client {
  id                 String          @id @default(uuid(7))
  ref                String          @unique
  type               ClientType
  displayName        String
  legalName          String?
  segment            ClientSegment   @default(OTHER)
  status             ClientStatus    @default(PROSPECT)
  primaryEmail       String?
  primaryPhone       String?
  countryOfResidence String?
  servicePackage     ServicePackage?
  accountManagerId   String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  accountManager    User?              @relation("ClientAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  users             ClientUser[]
  contacts          ClientContact[]
  onboarding        ClientOnboarding?
  managedProperties Property[]         @relation("PropertyManagingClient")
  ownerships        PropertyOwner[]
  leases            Lease[]
  rentCharges       RentCharge[]
  payments          Payment[]
  transactions      Transaction[]
  statements        Statement[]
  distributions     OwnerDistribution[]
  approvals         Approval[]
  ledgerAccounts    LedgerAccount[]
  messageThreads    MessageThread[]
  referralsMade     Referral[]         @relation("ReferralReferrer")

  @@index([status])
  @@index([segment])
  @@map("clients")
}

enum ClientUserRelationship {
  PRIMARY
  MEMBER
  ACCOUNTANT
  REPRESENTATIVE
}

model ClientUser {
  id           String                @id @default(uuid(7))
  clientId     String
  userId       String
  relationship ClientUserRelationship @default(PRIMARY)
  canApprove   Boolean               @default(false)
  invitedById  String?
  invitedAt    DateTime              @default(now())
  acceptedAt   DateTime?
  client       Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([userId])
  @@map("client_users")
}

model ClientContact {
  id          String   @id @default(uuid(7))
  clientId    String
  name        String
  role        String?
  email       String?
  phone       String?
  isEmergency Boolean  @default(false)
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

enum OnboardingStatus {
  IN_PROGRESS
  BLOCKED
  COMPLETE
}

enum KycStatus {
  NOT_STARTED
  SUBMITTED
  VERIFIED
  REJECTED
}

model ClientOnboarding {
  id                     String           @id @default(uuid(7))
  clientId               String           @unique
  currentStep            Int              @default(1)
  status                 OnboardingStatus @default(IN_PROGRESS)
  kycStatus              KycStatus        @default(NOT_STARTED)
  managementAgreementDocId String?
  agreementAcceptedAt    DateTime?
  startedAt              DateTime         @default(now())
  completedAt            DateTime?
  updatedAt              DateTime         @updatedAt
  client                 Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_onboardings")
}

enum LeadSource {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  LINKEDIN
  WEBSITE
  WHATSAPP
  REFERRAL
  EVENT
  DIASPORA_CAMPAIGN
  PROPERTY_RESCUE
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONSULTATION
  ASSESSMENT
  PROPOSAL
  WON
  LOST
}

enum LeadGrade {
  A
  B
  C
  D
}

model Lead {
  id               String       @id @default(uuid(7))
  ref              String       @unique
  name             String
  email            String
  phone            String
  source           LeadSource   @default(OTHER)
  campaign         String?
  segment          String?
  propertyCount    Int?
  propertyType     String?
  location         String?
  serviceInterest  String[]
  livesInGhana     Boolean?
  biggestChallenge String?
  score            Int          @default(0)
  grade            LeadGrade    @default(D)
  status           LeadStatus   @default(NEW)
  ownerUserId      String?
  convertedClientId String?
  consent          Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  owner        User?           @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  activities   LeadActivity[]
  surveyResponses SurveyResponse[]
  healthChecks PropertyHealthCheck[]

  @@index([status, grade])
  @@index([source])
  @@map("leads")
}

enum LeadActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  STATUS_CHANGE
  TASK
}

model LeadActivity {
  id          String           @id @default(uuid(7))
  leadId      String
  type        LeadActivityType
  body        String
  byUserId    String?
  occurredAt  DateTime         @default(now())
  dueAt       DateTime?
  completedAt DateTime?
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  byUser      User?            @relation(fields: [byUserId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@map("lead_activities")
}

model LeadScoreConfig {
  id          String   @id @default(uuid(7))
  version     Int      @unique
  factors     Json
  active      Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())

  @@map("lead_score_configs")
}

enum EarlyAccessCampaign {
  FOUNDING_100
  EARLY_ACCESS
  OWNER_CLUB
}

model EarlyAccessRegistration {
  id            String              @id @default(uuid(7))
  name          String
  email         String
  phone         String
  propertyCount Int?
  location      String?
  interest      String?
  campaign      EarlyAccessCampaign @default(EARLY_ACCESS)
  status        String              @default("REGISTERED")
  createdAt     DateTime            @default(now())

  @@index([campaign])
  @@map("early_access_registrations")
}

enum ReferralType {
  OWNER
  INVESTOR
  DEVELOPER
}

model Referral {
  id               String       @id @default(uuid(7))
  referrerClientId String
  refereeName      String
  refereeContact   String
  type             ReferralType
  status           String       @default("SUBMITTED")
  createdAt        DateTime     @default(now())
  referrer         Client       @relation("ReferralReferrer", fields: [referrerClientId], references: [id], onDelete: Cascade)

  @@index([referrerClientId])
  @@map("referrals")
}

// ===========================================================================
// Property, Building, Unit
// ===========================================================================

enum PropertyType {
  OFFICE
  RETAIL
  WAREHOUSE
  MIXED_USE
  APARTMENT
  HOUSE
  LAND
  SHORT_STAY
  OTHER
}

enum PropertyStatus {
  ACTIVE
  VACANT
  OCCUPIED
  UNDER_MAINTENANCE
  UNDER_RENOVATION
  SUSPENDED
  SOLD
  ARCHIVED
}

enum UnitStatus {
  VACANT
  OCCUPIED
  RESERVED
  MAINTENANCE
  UNAVAILABLE
}

model PropertyLocationArea {
  id     String @id @default(uuid(7))
  name   String
  city   String
  region String

  properties Property[]

  @@unique([name, city, region])
  @@map("property_location_areas")
}

model Property {
  id                  String         @id @default(uuid(7))
  ref                 String         @unique
  clientId            String
  name                String
  type                PropertyType
  status              PropertyStatus @default(VACANT)
  addressLine         String
  areaId              String?
  city                String
  region              String
  country             String         @default("GH")
  gpsLat              Decimal?       @db.Decimal(9, 6)
  gpsLng              Decimal?       @db.Decimal(9, 6)
  ownershipStatus     String?
  acquisitionDate     DateTime?      @db.Date
  estimatedValueMinor BigInt?
  estimatedValueCurrency String?
  valuationDate       DateTime?      @db.Date
  unitCount           Int            @default(0)
  bedrooms            Int?
  bathrooms           Int?
  floorAreaSqm        Decimal?       @db.Decimal(12, 2)
  landSizeSqm         Decimal?       @db.Decimal(12, 2)
  description         String?
  coverImageDocumentId String?
  onboardingComplete  Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  managingClient     Client                 @relation("PropertyManagingClient", fields: [clientId], references: [id])
  area               PropertyLocationArea?  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  owners             PropertyOwner[]
  agreements         ManagementAgreement[]
  buildings          Building[]
  units              Unit[]
  assignments        PropertyAssignment[]
  leases             Lease[]
  rentCharges        RentCharge[]
  payments           Payment[]
  transactions       Transaction[]
  expenses           Expense[]
  maintenanceRequests MaintenanceRequest[]
  inspections        Inspection[]
  preventivePlans    PreventiveMaintenancePlan[]
  healthScores       PropertyHealthScore[]
  rescueAssessments  PropertyRescueAssessment[]
  statements         Statement[]
  distributions      OwnerDistribution[]
  approvals          Approval[]
  onboardingChecklist PropertyOnboardingChecklist?
  messageThreads     MessageThread[]
  ledgerAccounts     LedgerAccount[]
  vendorAssignments  VendorPropertyAssignment[]

  @@index([clientId, status])
  @@index([region, city])
  @@index([status])
  @@index([type])
  @@map("properties")
}

model PropertyOwner {
  id           String   @id @default(uuid(7))
  propertyId   String
  clientId     String
  sharePercent Decimal  @default(100) @db.Decimal(5, 2)
  isPrimary    Boolean  @default(true)
  createdAt    DateTime @default(now())
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([propertyId, clientId])
  @@index([clientId])
  @@map("property_owners")
}

enum ManagementFeeType {
  PERCENT_OF_COLLECTED
  PERCENT_OF_EXPECTED
  FIXED_MONTHLY
  CUSTOM
}

enum InspectionFrequency {
  MONTHLY
  QUARTERLY
  BIANNUAL
  ANNUAL
  CUSTOM
}

enum AgreementStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

model ManagementAgreement {
  id                             String              @id @default(uuid(7))
  propertyId                     String
  feeType                        ManagementFeeType
  feePercent                     Decimal?            @db.Decimal(5, 2)
  feeFixedMinor                  BigInt?
  feeCurrency                    String              @default("GHS")
  startDate                      DateTime            @db.Date
  endDate                        DateTime?           @db.Date
  inspectionFrequency            InspectionFrequency @default(QUARTERLY)
  maintenanceApprovalThresholdMinor BigInt           @default(0)
  thresholdCurrency              String              @default("GHS")
  documentId                     String?
  status                         AgreementStatus     @default(DRAFT)
  createdById                    String?
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @updatedAt
  property                       Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@map("management_agreements")
}

model Building {
  id          String   @id @default(uuid(7))
  propertyId  String
  name        String
  floorsCount Int?
  createdAt   DateTime @default(now())
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  floors      Floor[]
  units       Unit[]

  @@index([propertyId])
  @@map("buildings")
}

model Floor {
  id         String   @id @default(uuid(7))
  buildingId String
  level      Int
  label      String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  units      Unit[]

  @@unique([buildingId, level])
  @@map("floors")
}

model Unit {
  id                String     @id @default(uuid(7))
  propertyId        String
  buildingId        String?
  floorId           String?
  ref               String     @unique
  label             String
  bedrooms          Int?
  bathrooms         Int?
  floorAreaSqm      Decimal?   @db.Decimal(12, 2)
  marketRentMinor   BigInt?
  marketRentCurrency String?
  status            UnitStatus @default(VACANT)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  property  Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  building  Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floor     Floor?    @relation(fields: [floorId], references: [id], onDelete: SetNull)
  leases    Lease[]
  rentCharges RentCharge[]
  payments  Payment[]
  maintenanceRequests MaintenanceRequest[]
  inspections Inspection[]

  @@index([propertyId, status])
  @@map("units")
}

enum PropertyAssignmentRole {
  PROPERTY_MANAGER
  MAINTENANCE_OFFICER
  INSPECTOR
  LEASING_OFFICER
  SUPPORT_STAFF
}

model PropertyAssignment {
  id         String                 @id @default(uuid(7))
  propertyId String
  userId     String
  role       PropertyAssignmentRole
  startDate  DateTime               @db.Date
  endDate    DateTime?              @db.Date
  createdAt  DateTime               @default(now())
  property   Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId, role])
  @@index([userId])
  @@map("property_assignments")
}

model PropertyOnboardingChecklist {
  id                String   @id @default(uuid(7))
  propertyId        String   @unique
  items             Json
  completionPercent Int      @default(0)
  status            String   @default("IN_PROGRESS")
  updatedAt         DateTime @updatedAt
  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_onboarding_checklists")
}

// ===========================================================================
// Tenants & Leases
// ===========================================================================

enum TenantStatus {
  PROSPECTIVE
  ACTIVE
  NOTICE_GIVEN
  FORMER
}

model Tenant {
  id                    String       @id @default(uuid(7))
  ref                   String       @unique
  userId                String?      @unique
  fullName              String
  phone                 String
  email                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  idDocumentType        String?
  idDocumentRefEnc      String?
  idDocumentFileId      String?
  status                TenantStatus @default(PROSPECTIVE)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  loginUser           User?        @relation("TenantLoginUser", fields: [userId], references: [id], onDelete: SetNull)
  leaseParties        LeaseParty[]
  payments            Payment[]
  transactions        Transaction[]
  maintenanceRequests MaintenanceRequest[]

  @@index([status])
  @@map("tenants")
}

enum LeaseFrequency {
  MONTHLY
  QUARTERLY
  BIANNUAL
  ANNUAL
  CUSTOM
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRING
  EXPIRED
  TERMINATED
  RENEWED
}

enum RenewalStatus {
  NONE
  OFFERED
  ACCEPTED
  DECLINED
}

model Lease {
  id                 String         @id @default(uuid(7))
  ref                String         @unique
  propertyId         String
  unitId             String
  clientId           String
  startDate          DateTime       @db.Date
  endDate            DateTime       @db.Date
  rentMinor          BigInt
  rentCurrency       String         @default("GHS")
  frequency          LeaseFrequency @default(MONTHLY)
  customFrequencyDays Int?
  depositMinor       BigInt?
  depositCurrency    String?
  noticePeriodDays   Int            @default(30)
  renewalStatus      RenewalStatus  @default(NONE)
  documentId         String?
  status             LeaseStatus    @default(DRAFT)
  terminatedAt       DateTime?
  terminationReason  String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  property   Property        @relation(fields: [propertyId], references: [id])
  unit       Unit            @relation(fields: [unitId], references: [id])
  client     Client          @relation(fields: [clientId], references: [id])
  parties    LeaseParty[]
  rentCharges RentCharge[]
  payments   Payment[]
  reminders  LeaseReminder[]
  transactions Transaction[]

  @@index([propertyId, status])
  @@index([unitId])
  @@index([clientId])
  @@index([endDate, status])
  @@map("leases")
}

model LeaseParty {
  id        String  @id @default(uuid(7))
  leaseId   String
  tenantId  String
  isPrimary Boolean @default(true)
  lease     Lease   @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([leaseId, tenantId])
  @@index([tenantId])
  @@map("lease_parties")
}

enum LeaseReminderType {
  EXPIRY
  RENEWAL
  RENT_REVIEW
  CUSTOM
}

model LeaseReminder {
  id       String            @id @default(uuid(7))
  leaseId  String
  type     LeaseReminderType
  remindAt DateTime
  sentAt   DateTime?
  note     String?
  lease    Lease             @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([remindAt, sentAt])
  @@map("lease_reminders")
}

// ===========================================================================
// Finance & Ledger
// ===========================================================================

enum LedgerAccountType {
  COMPANY_OPERATING
  OWNER_FUNDS
  TENANT_DEPOSITS
  PROPERTY_EXPENSE
  VENDOR_PAYABLE
  OWNER_DISTRIBUTION
  RENT_INCOME
}

model LedgerAccount {
  id         String            @id @default(uuid(7))
  type       LedgerAccountType
  clientId   String?
  propertyId String?
  currency   String            @default("GHS")
  createdAt  DateTime          @default(now())
  client     Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  property   Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@unique([type, clientId, propertyId, currency])
  @@map("ledger_accounts")
}

enum TransactionType {
  RENT_CHARGE
  RENT_PAYMENT
  EXPENSE
  MANAGEMENT_FEE
  OWNER_DISTRIBUTION
  DEPOSIT
  REFUND
  ADJUSTMENT
  REVERSAL
}

enum TransactionStatus {
  PENDING
  POSTED
  VOID
}

enum PaymentMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  BANK_DEPOSIT
  CASH
  ONLINE
  OTHER
  NONE
}

enum ReconciliationStatus {
  UNRECONCILED
  RECONCILED
  DISPUTED
}

model Transaction {
  id                   String               @id @default(uuid(7))
  ref                  String               @unique
  type                 TransactionType
  amountMinor          BigInt
  currency             String               @default("GHS")
  occurredAt           DateTime
  propertyId           String?
  unitId               String?
  leaseId              String?
  tenantId             String?
  clientId             String?
  vendorId             String?
  category             String?
  reference            String?
  method               PaymentMethod        @default(NONE)
  provider             String?
  status               TransactionStatus    @default(POSTED)
  reconciliationStatus ReconciliationStatus @default(UNRECONCILED)
  reversesTransactionId String?
  sourceEventId        String?
  createdById          String?
  approvedById         String?
  createdAt            DateTime             @default(now())

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  lease    Lease?    @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  client   Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  vendor   Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  statementLines StatementLine[]
  payment  Payment?
  distribution OwnerDistribution?

  @@index([clientId, occurredAt])
  @@index([propertyId, type])
  @@index([reconciliationStatus])
  @@map("transactions")
}

enum RentChargeStatus {
  EXPECTED
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
  REFUNDED
}

model RentCharge {
  id          String           @id @default(uuid(7))
  leaseId     String
  propertyId  String
  unitId      String
  clientId    String
  periodStart DateTime         @db.Date
  periodEnd   DateTime         @db.Date
  dueDate     DateTime         @db.Date
  amountMinor BigInt
  currency    String           @default("GHS")
  paidMinor   BigInt           @default(0)
  status      RentChargeStatus @default(EXPECTED)
  waivedById  String?
  waivedReason String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  lease       Lease               @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  property    Property            @relation(fields: [propertyId], references: [id])
  unit        Unit                @relation(fields: [unitId], references: [id])
  client      Client              @relation(fields: [clientId], references: [id])
  allocations PaymentAllocation[]

  @@unique([leaseId, periodStart])
  @@index([clientId, dueDate])
  @@index([dueDate, status])
  @@index([status])
  @@map("rent_charges")
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

model Payment {
  id                   String               @id @default(uuid(7))
  ref                  String               @unique
  tenantId             String?
  leaseId              String?
  propertyId           String
  unitId               String?
  clientId             String
