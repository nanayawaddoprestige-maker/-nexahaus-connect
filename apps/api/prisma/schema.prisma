  @@unique([paymentId, rentChargeId])
  @@index([rentChargeId])
  @@map("payment_allocations")
}

model PaymentProviderWebhookEvent {
  id                String    @id @default(uuid(7))
  provider          String
  providerEventId   String
  signatureValid    Boolean
  payload           Json
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?
  resultingPaymentId String?

  @@unique([provider, providerEventId])
  @@map("payment_provider_webhook_events")
}

enum ExpenseCategory {
  PLUMBING
  ELECTRICAL
  PAINTING
  CLEANING
  SECURITY
  LANDSCAPING
  AIR_CONDITIONING
  PEST_CONTROL
  REPAIRS
  INSURANCE
  UTILITIES
  OTHER
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
  VOID
}

enum ApprovalDecisionStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  DECLINED
}

enum PaymentSettlementStatus {
  UNPAID
  SCHEDULED
  PAID
}

model Expense {
  id                   String                  @id @default(uuid(7))
  ref                  String                  @unique
  propertyId           String
  unitId               String?
  vendorId             String?
  category             ExpenseCategory
