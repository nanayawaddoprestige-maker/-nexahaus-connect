  @@index([clientId, status])
  @@map("owner_distributions")
}

// ===========================================================================
// Maintenance
// ===========================================================================

enum MaintenanceReporterType {
  TENANT
  STAFF
  OWNER
  SYSTEM
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  REPORTED
  ACKNOWLEDGED
  ASSIGNED
  SCHEDULED
  IN_PROGRESS
  AWAITING_APPROVAL
  COMPLETED
  VERIFIED
  CLOSED
  CANCELLED
}

model MaintenanceRequest {
  id                String                  @id @default(uuid(7))
  ref               String                  @unique
  propertyId        String
  unitId            String?
  leaseId           String?
  reportedByType    MaintenanceReporterType
  reportedByUserId  String?
  reportedByTenantId String?
  category          String
  priority          MaintenancePriority     @default(MEDIUM)
  title             String
  description       String
  status            MaintenanceStatus       @default(REPORTED)
  estimatedCostMinor BigInt?
  approvedCostMinor  BigInt?
  actualCostMinor    BigInt?
  costCurrency      String?
  scheduledFor      DateTime?
  completedAt       DateTime?
  verifiedAt        DateTime?
  verifiedByUserId  String?
  closedAt          DateTime?
  cancellationReason String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  property        Property                  @relation(fields: [propertyId], references: [id])
  unit            Unit?                     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  reportedByTenant Tenant?                  @relation(fields: [reportedByTenantId], references: [id], onDelete: SetNull)
  statusHistory   MaintenanceStatusHistory[]
  workOrders      WorkOrder[]
  media           MaintenanceMedia[]
  expenses        Expense[]

  @@index([propertyId, status])
  @@index([priority, status])
  @@map("maintenance_requests")
}

model MaintenanceStatusHistory {
  id         String             @id @default(uuid(7))
  requestId  String
  fromStatus MaintenanceStatus?
  toStatus   MaintenanceStatus
  byUserId   String?
  note       String?
  changedAt  DateTime           @default(now())
  request    MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("maintenance_status_history")
}

enum WorkOrderStatus {
  DRAFT
  ISSUED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model WorkOrder {
  id                String          @id @default(uuid(7))
  ref               String          @unique
  requestId         String
  vendorId          String?
  assignedUserId    String?
  scheduledFor      DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  status            WorkOrderStatus @default(DRAFT)
  costMinor         BigInt?
  currency          String?
  invoiceDocumentId String?
  completionNotes   String?
  createdById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  request        MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendor         Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  media          MaintenanceMedia[]
  vendorPayments VendorPayment[]

  @@index([requestId])
  @@index([vendorId, status])
  @@map("work_orders")
}

enum MaintenanceMediaKind {
  BEFORE
  AFTER
  REPORTED
  OTHER
}

model MaintenanceMedia {
  id           String               @id @default(uuid(7))
  requestId    String?
  workOrderId  String?
  documentId   String
  kind         MaintenanceMediaKind @default(OTHER)
  caption      String?
  uploadedById String?
  createdAt    DateTime             @default(now())
  request      MaintenanceRequest?  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder?           @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([workOrderId])
  @@map("maintenance_media")
}

enum VendorType {
  COMPANY
  INDIVIDUAL
}

enum VendorStatus {
  ACTIVE
  SUSPENDED
  BLACKLISTED
}

model Vendor {
  id                  String       @id @default(uuid(7))
  ref                 String       @unique
  userId              String?      @unique
  name                String
  type                VendorType   @default(COMPANY)
  categories          String[]
  phone               String
  email               String?
  region              String?
  servicesDescription String?
  rating              Decimal?     @db.Decimal(3, 2)
  status              VendorStatus @default(ACTIVE)
  insuranceExpiryAt   DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  loginUser           User?        @relation("VendorLoginUser", fields: [userId], references: [id], onDelete: SetNull)
  propertyAssignments VendorPropertyAssignment[]
  documents           VendorDocument[]
  workOrders          WorkOrder[]
  expenses            Expense[]
  payments            VendorPayment[]
  transactions        Transaction[]

  @@index([status])
  @@map("vendors")
}

model VendorPropertyAssignment {
  id         String   @id @default(uuid(7))
  vendorId   String
  propertyId String
  addedById  String?
  addedAt    DateTime @default(now())
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([vendorId, propertyId])
  @@map("vendor_property_assignments")
}

enum VendorDocumentType {
  INSURANCE
  LICENCE
  CONTRACT
  OTHER
}

model VendorDocument {
  id         String             @id @default(uuid(7))
  vendorId   String
  documentId String
  type       VendorDocumentType
  vendor     Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_documents")
}

model VendorPayment {
  id            String        @id @default(uuid(7))
  vendorId      String
  expenseId     String?
  workOrderId   String?
  amountMinor   BigInt
  currency      String        @default("GHS")
  status        PaymentSettlementStatus @default(UNPAID)
  paidAt        DateTime?
  transactionId String?
  createdAt     DateTime      @default(now())
  vendor        Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  expense       Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  workOrder     WorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@map("vendor_payments")
}

model PreventiveMaintenancePlan {
  id          String              @id @default(uuid(7))
  propertyId  String
  unitId      String?
  serviceType String
  frequency   InspectionFrequency @default(QUARTERLY)
  intervalDays Int?
  nextDueAt   DateTime
  lastRunAt   DateTime?
  vendorId    String?
  active      Boolean             @default(true)
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  property    Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, active])
  @@index([nextDueAt, active])
  @@map("preventive_maintenance_plans")
}

// ===========================================================================
// Inspections
// ===========================================================================

model InspectionTemplate {
  id       String                    @id @default(uuid(7))
  name     String
  version  Int                       @default(1)
  isActive Boolean                   @default(true)
  createdAt DateTime                 @default(now())
  areas    InspectionTemplateArea[]
  inspections Inspection[]

  @@unique([name, version])
  @@map("inspection_templates")
}

model InspectionTemplateArea {
  id         String                   @id @default(uuid(7))
  templateId String
  name       String
  sortOrder  Int                      @default(0)
  template   InspectionTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items      InspectionTemplateItem[]

  @@index([templateId])
  @@map("inspection_template_areas")
}

model InspectionTemplateItem {
  id        String                 @id @default(uuid(7))
  areaId    String
  label     String
  sortOrder Int                    @default(0)
  area      InspectionTemplateArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([areaId])
  @@map("inspection_template_items")
}

enum InspectionType {
  INITIAL
  ROUTINE
  MOVE_IN
  MOVE_OUT
  MAINTENANCE
  EMERGENCY
  PRE_HANDOVER
  POST_MAINTENANCE
  ANNUAL
}

enum InspectionStatus {
  ASSIGNED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  REVIEWED
  REPORT_ISSUED
}

enum ConditionRating {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

model Inspection {
  id                    String            @id @default(uuid(7))
  ref                   String            @unique
  propertyId            String
  unitId                String?
  type                  InspectionType
  templateId            String?
  inspectorUserId       String
  status                InspectionStatus  @default(ASSIGNED)
  scheduledFor          DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  reviewedByUserId      String?
  reviewedAt            DateTime?
  overallCondition      ConditionRating?
  inspectorSignatureRef String?
  ownerReviewedAt       DateTime?
  reportDocumentId      String?
  createdById           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  property  Property            @relation(fields: [propertyId], references: [id])
  unit      Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  template  InspectionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  inspector User                @relation("InspectionInspector", fields: [inspectorUserId], references: [id])
  items     InspectionItem[]
  media     InspectionMedia[]

  @@index([propertyId, status])
  @@index([inspectorUserId, status])
  @@index([scheduledFor])
  @@map("inspections")
}

enum InspectionItemRating {
  GOOD
  ATTENTION_REQUIRED
  URGENT
  NOT_APPLICABLE
}

model InspectionItem {
  id             String               @id @default(uuid(7))
  inspectionId   String
  area           String
  label          String
  rating         InspectionItemRating @default(NOT_APPLICABLE)
  note           String?
  recommendation String?
  sortOrder      Int                  @default(0)
  inspection     Inspection           @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  media          InspectionMedia[]

  @@index([inspectionId])
  @@map("inspection_items")
}

model InspectionMedia {
  id               String          @id @default(uuid(7))
  inspectionId     String
  inspectionItemId String?
  documentId       String
  caption          String?
  capturedAt       DateTime?
  gpsLat           Decimal?        @db.Decimal(9, 6)
  gpsLng           Decimal?        @db.Decimal(9, 6)
  inspection       Inspection      @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  item             InspectionItem? @relation(fields: [inspectionItemId], references: [id], onDelete: SetNull)

  @@index([inspectionId])
  @@map("inspection_media")
}

// ===========================================================================
// Documents (Vault)
// ===========================================================================

enum DocumentScopeType {
  PROPERTY
  UNIT
  LEASE
  TENANT
  CLIENT
  MAINTENANCE_REQUEST
  WORK_ORDER
  INSPECTION
  EXPENSE
  STATEMENT
  VENDOR
  COMPLIANCE
  USER
}

enum DocumentCategory {
  PROPERTY
  OWNERSHIP
  TENANCY
  INSURANCE
  INSPECTION_REPORT
  MAINTENANCE_REPORT
  INVOICE
  RECEIPT
  VALUATION
  LEGAL
  TAX
  OTHER
}

enum MalwareScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model Document {
  id               String            @id @default(uuid(7))
  scopeType        DocumentScopeType
  scopeId          String
  category         DocumentCategory  @default(OTHER)
  title            String
  mimeType         String
  sizeBytes        BigInt
  checksumSha256   String
  storageKey       String            @unique
  currentVersionId String?
  uploadedById     String?
  expiresAt        DateTime?
  malwareScanStatus MalwareScanStatus @default(PENDING)
  status           DocumentStatus    @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  deletedById      String?

  versions        DocumentVersion[]
  accessLogs      DocumentAccessLog[]
  expiryReminders DocumentExpiryReminder[]
  messageAttachments MessageAttachment[]

  @@index([scopeType, scopeId])
  @@index([expiresAt])
  @@index([malwareScanStatus])
  @@map("documents")
}

model DocumentVersion {
  id             String   @id @default(uuid(7))
  documentId     String
  versionNo      Int
  storageKey     String   @unique
  sizeBytes      BigInt
  checksumSha256 String
  uploadedById   String?
  createdAt      DateTime @default(now())
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNo])
  @@map("document_versions")
}

enum DocumentAccessAction {
  VIEW
  DOWNLOAD
  UPLOAD
  DELETE
  SHARE
}

model DocumentAccessLog {
  id         String               @id @default(uuid(7))
  documentId String
  userId     String
  action     DocumentAccessAction
  ip         String?
  at         DateTime             @default(now())
  document   Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([userId, at])
  @@map("document_access_logs")
}

model DocumentExpiryReminder {
  id         String    @id @default(uuid(7))
  documentId String
  remindAt   DateTime
  offsetDays Int
  sentAt     DateTime?
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([remindAt, sentAt])
  @@map("document_expiry_reminders")
}

// ===========================================================================
// Communication & Notifications
// ===========================================================================

enum MessageThreadType {
  OWNER_NEXAHAUS
  TENANT_NEXAHAUS
  INTERNAL
  MAINTENANCE
}

model MessageThread {
  id             String            @id @default(uuid(7))
  type           MessageThreadType
  subjectRefType String?
  subjectRefId   String?
  clientId       String?
  propertyId     String?
  title          String
  status         String            @default("OPEN")
  createdById    String?
  createdAt      DateTime          @default(now())
  lastMessageAt  DateTime          @default(now())

  client       Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  property     Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  participants ThreadParticipant[]
  messages     Message[]

  @@index([clientId])
  @@index([type, status])
  @@map("message_threads")
}

enum ThreadParticipantRole {
  MEMBER
  OWNER_SIDE
  NEXAHAUS_SIDE
}

model ThreadParticipant {
  id         String                @id @default(uuid(7))
  threadId   String
  userId     String
  role       ThreadParticipantRole @default(MEMBER)
  lastReadAt DateTime?
  mutedAt    DateTime?
  thread     MessageThread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
  @@map("thread_participants")
}

model Message {
  id           String              @id @default(uuid(7))
  threadId     String
  senderUserId String
  body         String
  createdAt    DateTime            @default(now())
  editedAt     DateTime?
  deletedAt    DateTime?
  thread       MessageThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderUserId], references: [id])
  attachments  MessageAttachment[]

  @@index([threadId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id         String   @id @default(uuid(7))
  messageId  String
  documentId String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

model Notification {
  id            String    @id @default(uuid(7))
  userId        String
  type          String
  title         String
  body          String
  data          Json?
  channels      String[]
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  sourceEventId String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  id       String  @id @default(uuid(7))
  userId   String
  type     String
  inApp    Boolean @default(true)
  email    Boolean @default(true)
  sms      Boolean @default(false)
  whatsapp Boolean @default(false)
  push     Boolean @default(false)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

model DomainEvent {
  id         String    @id @default(uuid(7))
  type       String
  payload    Json
  occurredAt DateTime  @default(now())
  dedupeKey  String?   @unique
  processedAt DateTime?
  attempts   Int       @default(0)
  lastError  String?

  @@index([processedAt])
  @@index([type])
  @@map("domain_events")
}

// ===========================================================================
// Approvals
// ===========================================================================

enum ApprovalType {
  MAINTENANCE_COST
  EXPENSE
  RENT_CHANGE
  LEASE_TERMINATION
  DISTRIBUTION
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DECLINED
  INFO_REQUESTED
  CANCELLED
  EXPIRED
}

model Approval {
  id                String         @id @default(uuid(7))
  ref               String         @unique
  type              ApprovalType
  subjectRefType    String
  subjectRefId      String
  propertyId        String?
  clientId          String
  requestedByUserId String
  thresholdMinor    BigInt?
  thresholdCurrency String?
  amountMinor       BigInt?
  currency          String?
  status            ApprovalStatus @default(PENDING)
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?
  dueAt             DateTime?
  createdAt         DateTime       @default(now())

  property Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  client   Client          @relation(fields: [clientId], references: [id])
  events   ApprovalEvent[]

  @@index([clientId, status])
  @@index([status, dueAt])
  @@map("approvals")
}

enum ApprovalEventAction {
  CREATED
  VIEWED
  APPROVED
  DECLINED
  INFO_REQUESTED
  COMMENT
  CANCELLED
}

model ApprovalEvent {
  id         String              @id @default(uuid(7))
  approvalId String
  action     ApprovalEventAction
  byUserId   String?
  note       String?
  at         DateTime            @default(now())
  approval   Approval            @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([approvalId])
  @@map("approval_events")
}

// ===========================================================================
// Property Health & Rescue
// ===========================================================================

model HealthScoreConfig {
  id          String   @id @default(uuid(7))
  version     Int      @unique
  weights     Json
  active      Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())

  @@map("health_score_configs")
}

model PropertyHealthScore {
  id                String   @id @default(uuid(7))
  propertyId        String
  score             Int
  scoredAt          DateTime @default(now())
  methodologyVersion Int
  components        Json
  recommendations   Json?
  computedByJobId   String?
  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  componentRows     PropertyHealthComponent[]

  @@index([propertyId, scoredAt])
  @@map("property_health_scores")
}

model PropertyHealthComponent {
  id            String              @id @default(uuid(7))
  scoreId       String
  key           String
  rawValue      Decimal             @db.Decimal(9, 4)
  weight        Decimal             @db.Decimal(9, 4)
  weightedScore Decimal             @db.Decimal(9, 4)
  score         PropertyHealthScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@index([scoreId])
  @@index([key])
  @@map("property_health_components")
}

enum RescueStatus {
  DRAFT
  FINAL
}

model PropertyRescueAssessment {
  id               String       @id @default(uuid(7))
  ref              String       @unique
  propertyId       String
  overallScore     Int
  assessedAt       DateTime     @default(now())
  assessedByUserId String?
  inputs           Json
  findings         Json
  status           RescueStatus @default(DRAFT)
  pdfDocumentId    String?
  createdAt        DateTime     @default(now())
  property         Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  recommendations  PropertyRescueRecommendation[]

  @@index([propertyId])
  @@map("property_rescue_assessments")
}

enum RescueRecommendationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RescueRecommendationStatus {
  OPEN
  IN_PROGRESS
  DONE
  DISMISSED
}

model PropertyRescueRecommendation {
  id           String                      @id @default(uuid(7))
  assessmentId String
  sortOrder    Int                         @default(0)
  title        String
  detail       String
  priority     RescueRecommendationPriority @default(MEDIUM)
  status       RescueRecommendationStatus   @default(OPEN)
  assessment   PropertyRescueAssessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("property_rescue_recommendations")
}

// ===========================================================================
// Surveys, Health Check, Assessment
// ===========================================================================

enum SurveyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model Survey {
  id      String           @id @default(uuid(7))
  key     String           @unique
  name    String
  status  SurveyStatus     @default(DRAFT)
  version Int              @default(1)
  createdAt DateTime       @default(now())
  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@map("surveys")
}

enum SurveyQuestionType {
  SINGLE
  MULTI
  TEXT
  NUMBER
  SCALE
  BOOLEAN
}

model SurveyQuestion {
  id        String             @id @default(uuid(7))
  surveyId  String
  sortOrder Int                @default(0)
  type      SurveyQuestionType
  prompt    String
  options   Json?
  required  Boolean            @default(false)
  survey    Survey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@map("survey_questions")
}

model SurveyResponse {
  id          String   @id @default(uuid(7))
  surveyId    String
  leadId      String?
  submittedAt DateTime @default(now())
  answers     Json
  consent     Json?
  ipHash      String?
  userAgent   String?
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([surveyId])
  @@map("survey_responses")
}

model PropertyHealthCheck {
  id               String   @id @default(uuid(7))
  leadId           String?
  contactName      String
  email            String
  phone            String
  propertyInfo     Json
  answers          Json
  preliminaryScore Int
  consent          Json?
  createdAt        DateTime @default(now())
  lead             Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@map("property_health_checks")
}

enum AssessmentType {
  PRELIMINARY
  PROFESSIONAL
}

enum AssessmentStatus {
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model PropertyAssessment {
  id               String           @id @default(uuid(7))
  ref              String           @unique
  clientId         String?
  leadId           String?
  propertyRef      String?
  type             AssessmentType   @default(PRELIMINARY)
  status           AssessmentStatus @default(REQUESTED)
  requestedAt      DateTime         @default(now())
  scheduledFor     DateTime?
  assessorUserId   String?
  reportDocumentId String?
  notes            String?

  @@index([status])
  @@map("property_assessments")
}

// ===========================================================================
// Config, Compliance, Audit
// ===========================================================================

model OrganizationSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("organization_settings")
}

model SystemSetting {
  key   String @id
  value Json

  @@map("system_settings")
}

model AuditLog {
  id           String   @id @default(uuid(7))
  actorUserId  String?
  actorRoleKey String?
  action       String
  resourceType String
  resourceId   String?
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  sessionId    String?
  requestId    String?
  at           DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorUserId, at])
  @@index([at])
  @@map("audit_logs")
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

model Task {
  id             String     @id @default(uuid(7))
  title          String
  type           String
  assigneeUserId String?
  dueAt          DateTime?
  status         TaskStatus @default(OPEN)
  relatedRefType String?
  relatedRefId   String?
  createdById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  assignee       User?      @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)

  @@index([assigneeUserId, status])
  @@index([dueAt, status])
  @@map("tasks")
}

enum LicenceScope {
  ORG
  USER
}

enum LicenceType {
  REAL_ESTATE_AGENT
  BROKER
  VALUER
  OTHER
}

enum LicenceStatus {
  ACTIVE
  PENDING
  EXPIRED
  REVOKED
}

model PractitionerLicence {
  id               String        @id @default(uuid(7))
  scope            LicenceScope
  userId           String?
  type             LicenceType
  number           String
  status           LicenceStatus @default(PENDING)
  issuedAt         DateTime?
  expiresAt        DateTime?
  designatedBroker String?
  documentId       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([expiresAt])
  @@map("practitioner_licences")
}

enum ComplianceCategory {
  COMPANY_DOC
  TAX
  INSURANCE
  LICENCE
  DATA_PROTECTION
  EMPLOYEE
  PROPERTY_DOC
  LEASE_DOC
}

enum ComplianceItemStatus {
  OK
  DUE_SOON
  EXPIRED
  MISSING
}

model ComplianceItem {
  id          String               @id @default(uuid(7))
  category    ComplianceCategory
  title       String
  documentId  String?
  expiresAt   DateTime?
  status      ComplianceItemStatus @default(MISSING)
  ownerUserId String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([category, status])
  @@index([expiresAt])
  @@map("compliance_items")
}

enum ConsentSubjectType {
  LEAD
  TENANT
  CLIENT
  USER
  SURVEY_RESPONDENT
}

model ConsentRecord {
  id          String             @id @default(uuid(7))
  subjectType ConsentSubjectType
  subjectId   String
  purpose     String
  lawfulBasis String
  grantedAt   DateTime           @default(now())
  revokedAt   DateTime?
  source      String
  evidence    Json?

  @@index([subjectType, subjectId])
  @@map("consent_records")
}

model RetentionPolicy {
  id                 String   @id @default(uuid(7))
  resourceType       String   @unique
  retainForDays      Int
  action             String
  legalHoldSupported Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("retention_policies")
}

enum DataSubjectRequestType {
  ACCESS
  EXPORT
  ERASURE
  RECTIFICATION
}

enum DataSubjectRequestStatus {
  RECEIVED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model DataSubjectRequest {
  id              String                   @id @default(uuid(7))
  subjectType     ConsentSubjectType
  subjectId       String
  type            DataSubjectRequestType
  status          DataSubjectRequestStatus @default(RECEIVED)
  requestedAt     DateTime                 @default(now())
  completedAt     DateTime?
  handledByUserId String?
  notes           String?

  @@index([status])
  @@map("data_subject_requests")
}

model Sequence {
  key       String @id
  nextValue BigInt @default(1)

  @@map("sequences")
}

// ===========================================================================
// Integrations
// ===========================================================================

enum ImportEntity {
  CLIENT
  PROPERTY
  UNIT
  TENANT
}

enum ImportStatus {
  VALIDATED
  COMMITTING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
}

model ImportJob {
  id          String       @id @default(uuid(7))
  ref         String       @unique
  entity      ImportEntity
  status      ImportStatus  @default(VALIDATED)
  totalRows   Int
  validRows   Int
  errorRows   Int
  /// [{ row: number, field?: string, message: string }]
  errors      Json
  /// Committed row refs / ids, and any commit-time failures.
  result      Json?
  createdById String?
  createdAt   DateTime      @default(now())
  committedAt DateTime?

  @@index([entity, status])
  @@map("import_jobs")
}

model WhatsAppInboundMessage {
  id            String    @id @default(uuid(7))
  provider      String
  providerMsgId String
  fromPhone     String
  body          String
  receivedAt    DateTime  @default(now())
  matchedUserId String?
  threadId      String?
  processedAt   DateTime?

  @@unique([provider, providerMsgId])
  @@index([fromPhone])
  @@map("whatsapp_inbound_messages")
}

model AnalyticsEvent {
  id        String   @id @default(uuid(7))
  name      String
  userId    String?
  anonId    String?
  props     Json?
  occurredAt DateTime @default(now())

  @@index([name, occurredAt])
  @@index([userId])
  @@map("analytics_events")
}
