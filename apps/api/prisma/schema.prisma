enum ApprovalDecision {
  APPROVED
  DECLINED
  INFO_REQUESTED
}

model ExpenseApproval {
  id            String           @id @default(uuid(7))
  expenseId     String
  approvalId    String?
  approverUserId String
  decision      ApprovalDecision
  note          String?
  decidedAt     DateTime         @default(now())
  expense       Expense          @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@map("expense_approvals")
}

enum StatementStatus {
  DRAFT
  ISSUED
  SENT
  ARCHIVED
}

model Statement {
  id                       String          @id @default(uuid(7))
  ref                      String          @unique
  clientId                 String
  propertyId               String?
  periodStart              DateTime        @db.Date
  periodEnd                DateTime        @db.Date
  openingBalanceMinor      BigInt          @default(0)
  closingBalanceMinor      BigInt          @default(0)
  currency                 String          @default("GHS")
  grossRentalIncomeMinor   BigInt          @default(0)
  managementFeesMinor      BigInt          @default(0)
  maintenanceExpensesMinor BigInt          @default(0)
  otherExpensesMinor       BigInt          @default(0)
