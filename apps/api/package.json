{
  "name": "@nexahaus/api",
  "version": "0.0.0",
  "private": true,
  "description": "NexaHaus Connect REST API (NestJS)",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "worker": "node dist/worker.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "dotenv -e ../../.env.test -e ../../.env -- jest",
    "test:watch": "dotenv -e ../../.env.test -e ../../.env -- jest --watch",
    "test:cov": "dotenv -e ../../.env.test -e ../../.env -- jest --coverage",
    "test:e2e": "dotenv -e ../../.env.test -e ../../.env -- jest --config ./test/jest-e2e.json",
    "prisma": "dotenv -e ../../.env -- prisma",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.658.1",
    "@aws-sdk/s3-request-presigner": "3.658.1",
    "@nestjs/common": "10.4.4",
    "@nestjs/core": "10.4.4",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.4",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/terminus": "10.2.3",
    "@nestjs/throttler": "6.2.1",
    "@nexahaus/config": "workspace:*",
    "@nexahaus/types": "workspace:*",
    "@nexahaus/validation": "workspace:*",
    "@prisma/client": "5.20.0",
    "argon2": "0.41.1",
    "bullmq": "5.13.2",
    "helmet": "7.1.0",
    "ioredis": "5.4.1",
    "nestjs-pino": "4.1.0",
    "otplib": "12.0.1",
    "pdfkit": "0.15.0",
    "pino-http": "10.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/schematics": "10.1.4",
    "@nestjs/testing": "10.4.4",
    "@nexahaus/eslint-config": "workspace:*",
    "@nexahaus/typescript-config": "workspace:*",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.13",
    "@types/node": "20.16.10",
    "@types/pdfkit": "0.13.4",
    "@types/supertest": "6.0.2",
    "dotenv-cli": "7.4.2",
    "eslint": "9.11.1",
    "jest": "29.7.0",
    "pino-pretty": "11.2.2",
    "prisma": "5.20.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "tsx": "4.19.1",
    "typescript": "5.6.2"
  }
}
