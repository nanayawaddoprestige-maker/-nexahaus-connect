{
  "name": "nexahaus-connect",
  "version": "0.0.0",
  "private": true,
  "description": "NexaHaus Connect — property and asset management platform for NexaHaus Properties & Asset Management Ltd.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "pnpm --filter @nexahaus/api prisma migrate dev",
    "db:deploy": "pnpm --filter @nexahaus/api prisma migrate deploy",
    "db:seed": "pnpm --filter @nexahaus/api db:seed",
    "db:studio": "pnpm --filter @nexahaus/api prisma studio",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "turbo": "2.1.3",
    "typescript": "5.6.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "18",
        "react-dom": "18"
      }
    },
    "overrides": {
      "@types/react": "18.3.10",
      "@types/react-dom": "18.3.0"
    }
  }
}
