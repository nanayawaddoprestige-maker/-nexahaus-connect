# Test overrides — layered on top of .env by the api test scripts.
NODE_ENV=test
LOG_LEVEL=warn
SEED_DEMO_DATA=false
# Exercise the HMAC webhook path in tests.
PAYMENT_PROVIDER=generic
PAYMENT_WEBHOOK_SECRET=test-webhook-secret-0123456789abcdef0123
# Point at a disposable test database — override in CI.
DATABASE_URL=postgresql://nexahaus:nexahaus@localhost:5432/nexahaus_test?schema=public
