# ============================================================================
# NexaHaus Connect — Environment configuration
# Copy to .env and fill in. NEVER commit .env. All secrets come from here.
# ============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
LOG_LEVEL=info                     # error | warn | info | debug
DEFAULT_CURRENCY=GHS
DEFAULT_LOCALE=en-GH
DEFAULT_TIMEZONE=Africa/Accra

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://nexahaus:nexahaus@localhost:5432/nexahaus?schema=public

# --- Redis (cache + BullMQ job queue) --------------------------------------
REDIS_URL=redis://localhost:6379

# --- Background processing -----------------------------------------------
# WORKER_ENABLED=true creates the BullMQ consumers in this process. In prod run
# the API with WORKER_ENABLED=false + DISABLE_SCHEDULERS=true, and a dedicated
# worker process (apps/api/dist/worker.js) with the defaults.
WORKER_ENABLED=true
DISABLE_SCHEDULERS=false
QUEUE_PREFIX=nexahaus

# --- Authentication --------------------------------------------------------
# Use long random values (min 32 bytes). Rotate per environment.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=900                 # seconds (15 min)
JWT_REFRESH_TTL=2592000            # seconds (30 days)
ARGON2_MEMORY_KIB=19456           # OWASP-recommended argon2id params
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
OTP_TTL=300                        # seconds
OTP_MAX_ATTEMPTS=5
MFA_ISSUER=NexaHaus Connect

# --- Rate limiting / abuse -----------------------------------------------
RATE_LIMIT_WINDOW=60              # seconds
RATE_LIMIT_MAX=100               # requests per window per IP
AUTH_RATE_LIMIT_MAX=10          # login/OTP attempts per window per IP+account

# --- Object storage (S3-compatible; MinIO locally) ---------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=nexahaus-documents
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL=300        # seconds — short-lived private download URLs
STORAGE_MAX_UPLOAD_BYTES=26214400 # 25 MB
MALWARE_SCAN_PROVIDER=noop        # noop | clamav | <vendor>
MALWARE_SCAN_ENDPOINT=

# --- Notification adapters (interface-based; swappable) ---------------
EMAIL_PROVIDER=console            # console | ses | sendgrid | postmark | <vendor>
EMAIL_API_KEY=
EMAIL_FROM=no-reply@nexahaus.example

SMS_PROVIDER=console              # console | <ghana-sms-vendor>
SMS_API_KEY=
SMS_SENDER_ID=NexaHaus

WHATSAPP_PROVIDER=noop            # noop | <whatsapp-bsp>
WHATSAPP_API_KEY=

PUSH_PROVIDER=noop                # noop | expo | fcm
PUSH_API_KEY=

# --- Payments (provider abstraction; NEVER hardcode a provider) ------
PAYMENT_PROVIDER=manual           # manual | <ghana-momo/bank-provider>
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=change-me-webhook-signing-secret
PAYMENT_CALLBACK_URL=http://localhost:4000/api/v1/payments/webhook

# --- Analytics (abstraction; swappable) ----------------------------
ANALYTICS_PROVIDER=noop           # noop | posthog | <vendor>
ANALYTICS_API_KEY=
ANALYTICS_HOST=

# --- Error / performance monitoring (both opt-in; unset = disabled) ------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=      # e.g. http://otel-collector:4318
OTEL_SERVICE_NAME=nexahaus-api
APP_RELEASE=                       # git sha / version tag, stamped on events

# --- Demo / seed accounts (development only) ---------------------
SEED_DEMO_DATA=true
DEMO_OWNER_EMAIL=owner.demo@nexahaus.example
DEMO_ADMIN_EMAIL=admin.demo@nexahaus.example
DEMO_ACCOUNT_PASSWORD=change-me-demo-password

# ============================================================================
# Marketing web app (apps/web) — PUBLIC, build-time inlined.
# Only NEXT_PUBLIC_* vars are readable in the browser. All have safe defaults;
# nothing about NexaHaus is hard-coded to an unverified value. Leave a value
# blank to use the built-in default / hide the related UI.
# ============================================================================

# Canonical origin (no trailing slash). Drives metadata, canonical URLs, sitemap.
NEXT_PUBLIC_SITE_URL=https://www.nexahaus.com

# Pre-launch messaging. true = "Building now. Launching in Accra December 2027";
# false = "Now serving property owners from Accra".
NEXT_PUBLIC_PRE_LAUNCH_MODE=true
NEXT_PUBLIC_LAUNCH_DATE=2027-12-01     # countdown target; day is a placeholder
NEXT_PUBLIC_LAUNCH_CITY=Accra
NEXT_PUBLIC_LAUNCH_LABEL=December 2027

# "Client Login" / portal links. Point at the NexaHaus Connect app in prod
# (e.g. https://app.nexahaus.com); defaults to the in-repo /login route.
NEXT_PUBLIC_CLIENT_PORTAL_URL=/login

# Same-origin base for the NestJS marketing endpoints (proxied in dev).
NEXT_PUBLIC_API_BASE=/api/v1/public

# Master indexing switch. Set false on staging/preview to block all crawlers.
NEXT_PUBLIC_ALLOW_INDEXING=true

# WhatsApp business number, E.164 WITHOUT "+", e.g. 233201234567.
# Empty = the "Chat With NexaHaus" button is not rendered (never invent a number).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Contact details — leave blank until official; the UI routes enquiries through
# the on-site forms rather than showing a placeholder address / inbox.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_CITY=Accra
NEXT_PUBLIC_CONTACT_COUNTRY=Ghana

# Social profiles — empty entries are not rendered (never invent URLs).
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# Analytics abstraction. noop (default) loads nothing. posthog forwards events to
# a page-provided window.posthog. No IDs are hard-coded; consent-gated at runtime.
NEXT_PUBLIC_ANALYTICS_PROVIDER=noop
NEXT_PUBLIC_ANALYTICS_KEY=
NEXT_PUBLIC_ANALYTICS_HOST=

# Optional photography. Root-relative (put files in apps/web/public) or an
# absolute URL on a configured image host. Empty = designed non-photo fallback.
NEXT_PUBLIC_HERO_IMAGE=
NEXT_PUBLIC_HERO_IMAGE_ALT=A contemporary residential property in Accra, Ghana
NEXT_PUBLIC_OG_IMAGE=
